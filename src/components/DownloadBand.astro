---
// Desktop download band (download-center): renders the newest snapshot
// release only, from the committed desktop-releases.json — zero network.
// A GitHub-only platform entry is the transitional state (official direct
// link pending) and carries the coming-soon note; the empty snapshot
// renders a bilingual coming-soon state with no download links (design D3).
import { t } from '../i18n';
import {
  loadDesktopReleases,
  DESKTOP_PLATFORMS,
  type DesktopPlatformKey,
} from '../lib/desktop-releases';

interface Props {
  locale: 'en' | 'zh';
}
const { locale } = Astro.props;

const { releases } = loadDesktopReleases();
const latest = releases[0] ?? null;
// Closed platform set, fixed display order regardless of JSON key order.
const keys = latest
  ? DESKTOP_PLATFORMS.filter((k) => latest.platforms[k as DesktopPlatformKey])
  : [];
---

<section class="download-band" id="download" aria-labelledby="download-title">
  <h2 id="download-title">{t(locale, 'download.title')}</h2>
  <p class="band-sub">{t(locale, 'download.sub')}</p>

  {
    latest ? (
      <div class="band-release">
        <p class="band-meta">
          v{latest.version} · {latest.released_at}
        </p>
        {keys.map((k) => {
          const p = latest.platforms[k as DesktopPlatformKey]!;
          const official = p.official_url || null;
          const github = p.github_url || null;
          return (
            <div class="band-row">
              <div class="band-platform">
                <span class="band-name">{t(locale, `download.platform.${k}` as const)}</span>
                {p.beta && <span class="band-beta">{t(locale, 'download.beta')}</span>}
              </div>
              <div class="band-links">
                {official && (
                  <a class="band-get primary" href={official} target="_blank" rel="noopener noreferrer">
                    {t(locale, 'download.action')} · {t(locale, 'download.source.official')}
                  </a>
                )}
                {github && (
                  <a class:list={['band-get', { secondary: !!official }]} href={github} target="_blank" rel="noopener noreferrer">
                    {official ? t(locale, 'download.source.github') : `${t(locale, 'download.action')} · ${t(locale, 'download.source.github')}`}
                  </a>
                )}
                {!official && <p class="band-note">{t(locale, 'download.officialComingSoon')}</p>}
              </div>
            </div>
          );
        })}
        <p class="band-unsigned">{t(locale, 'download.unsigned.note')}</p>
      </div>
    ) : (
      <div class="band-empty">
        <p class="band-empty-title">{t(locale, 'download.empty.title')}</p>
        <p class="band-empty-body">{t(locale, 'download.empty.body')}</p>
      </div>
    )
  }
</section>

<style is:inline>
  /*
   * is:inline so the band's CSS never reaches pages that don't render it:
   * the /products/[line] route module statically imports both views, and a
   * processed block here would hoist onto every catalog page. Selectors are
   * band-*/download-band namespaced — unique site-wide.
   */
  .download-band {
    margin-top: 64px;
    border-top: 1px solid var(--border);
    padding-top: 34px;
  }
  .download-band h2 { font-size: var(--fs-h2); margin: 0 0 6px; }
  .band-sub { color: var(--muted); margin: 0 0 24px; max-width: 68ch; }
  .band-release {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .band-meta {
    margin: 0;
    color: var(--accent);
    font-family: var(--mono);
    font-size: var(--fs-mono);
  }
  .band-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 16px;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 14px;
  }
  .band-platform { display: flex; align-items: center; gap: 10px; }
  .band-name { font-weight: 700; }
  .band-beta {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--accent-2);
    border: 1px solid var(--accent-2);
    border-radius: 999px;
    padding: 1px 9px;
    letter-spacing: 0.06em;
  }
  .band-links { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .band-get {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 10px;
    padding: 9px 18px;
    font-weight: 600;
  }
  .band-get.primary { background: var(--accent); color: #06201b; }
  .band-get.primary:hover { text-decoration: none; filter: brightness(1.07); }
  .band-get.secondary { border: 1px solid var(--border); color: var(--text); }
  .band-get.secondary:hover { text-decoration: none; border-color: var(--accent); }
  .band-note { margin: 0; color: var(--muted); font-size: 0.85rem; }
  .band-unsigned {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.6;
    border-top: 1px solid var(--border);
    padding-top: 12px;
  }
  .band-empty {
    background: var(--bg-soft);
    border: 1px dashed var(--border-strong);
    border-radius: 14px;
    padding: 26px 24px;
  }
  .band-empty-title { margin: 0 0 6px; font-weight: 700; }
  .band-empty-body { margin: 0; color: var(--muted); max-width: 68ch; }

  @media (max-width: 640px) {
    .band-row { grid-template-columns: 1fr; }
  }
</style>
