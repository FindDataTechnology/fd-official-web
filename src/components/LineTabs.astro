---
// The five-line tab navigation, shared by the products catalog and the base
// line's landing (extracted from ProductCatalog when the base line got its
// own landing — one owner of the tab markup).
//
// 2026-10-23 (crm-board-adoption): appended the service-board tab「客服台」.
// It is deliberately NOT a sixth line — the 一十百千万 ladder is capped by
// contract — so it (a) sits after a visual divider, (b) uses a non-ladder
// mark「服」, (c) carries a board tag, and (d) links to /crm (board landing),
// not /products/<line>. `line` prop accepts 'desk' for the active state on
// the board landing.
//
// 2026-11-07 (add-erp-domain 7.3): appended a SECOND board tab「ERP」, following
// the exact same precedent as the marketing/desk board — it is NOT a sixth
// line. It sits alongside the desk tab after the divider, uses a non-ladder
// mark「账」, carries a board tag「板块 / Board」, is bilingual-same-form
// (EN=ERP / 中文=ERP), and links to the board landing /erp (· /zh/erp), not
// /products/<line>. The 5 lines + the desk board stay byte-for-byte unchanged;
// PRODUCT_LINES / LADDER_* are a public contract and MUST NOT gain a sixth
// entry. `line` prop accepts 'erp' for the active state on the ERP landing.
import { PRODUCT_LINES, LADDER_CHARS, type ProductLine } from '../content.config';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';
import LineMark from './LineMark.astro';

interface Props {
  locale: string;
  line: ProductLine | 'desk' | 'erp';
}

const { locale, line } = Astro.props;
// Pinyin secondary labels tie the English line names back to the Chinese
// identity (寻数·壹座 → Yizuo); shown on EN pages only.
const PINYIN: Record<ProductLine, string> = {
  base: 'Yizuo',
  lex: 'Shilü',
  wire: 'Baixun',
  facet: 'Qianmian',
  constellation: 'Wanxing',
};
const deskName = locale === 'zh' ? '寻数·营销' : 'Marketing';
const deskTag = locale === 'zh' ? '板块' : 'Board';
const deskHref = 'https://marketing.finddatatech.cloud/';
// ERP board (add-erp-domain 7.3): bilingual-same-form name (EN=ERP / 中文=ERP),
// board tag, and a link to the local board landing. Non-ladder mark「账」.
const erpName = 'ERP';
const erpTag = locale === 'zh' ? '板块' : 'Board';
const erpHref = getRelativeLocaleUrl(locale, 'erp');
---

<nav class="line-tabs" aria-label={t(locale, 'apps.title')}>
  {
    PRODUCT_LINES.map((l) => (
      <a href={getRelativeLocaleUrl(locale, `products/${l}`)} class={l === line ? 'active' : ''} aria-current={l === line ? 'page' : undefined}>
        <LineMark char={LADDER_CHARS[PRODUCT_LINES.indexOf(l)]} name={t(locale, `line.${l}` as const)} size="xs" />
        <span>{t(locale, `line.${l}` as const)}</span>
        {locale === 'en' && <span class="tab-pin"> · {PINYIN[l]}</span>}
        {l === 'constellation' && <span class="tab-tag"> · {t(locale, 'line.constellation.tag')}</span>}
      </a>
    ))
  }
  <span class="tab-divider" aria-hidden="true"></span>
  <a href={deskHref} class={line === 'desk' ? 'active' : ''} aria-current={line === 'desk' ? 'page' : undefined}>
    <LineMark char="服" name={deskName} size="xs" />
    <span>{deskName}</span>
    <span class="tab-tag"> · {deskTag}</span>
  </a>
  <a href={erpHref} class={line === 'erp' ? 'active' : ''} aria-current={line === 'erp' ? 'page' : undefined}>
    <LineMark char="账" name={erpName} size="xs" />
    <span>{erpName}</span>
    <span class="tab-tag"> · {erpTag}</span>
  </a>
</nav>

<style>
  .line-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 24px;
    align-items: center;
  }
  .line-tabs a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.85rem;
    letter-spacing: 1px;
    padding: 5px 14px 5px 8px;
    border-radius: 999px;
    color: var(--muted);
    border: 1px solid var(--border);
    text-decoration: none;
  }
  .line-tabs a.active { padding-left: 8px; }
  .line-tabs a:hover {
    color: var(--text);
    border-color: var(--border-strong);
    text-decoration: none;
  }
  .line-tabs a.active {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(56, 225, 200, 0.08);
    font-weight: 700;
  }
  .tab-pin {
    opacity: 0.7;
    font-weight: 400;
  }
  .tab-tag {
    opacity: 0.8;
    font-weight: 400;
  }
  /* 板块分隔线：五线阶梯（一十百千万）与客服台板块之间的视觉断口 */
  .tab-divider {
    width: 1px;
    height: 22px;
    background: var(--border-strong);
    margin: 0 4px;
  }
</style>
