---
// Pinned live-service card: the self-hosted LibreChat deployment with the
// FindData MCP servers wired in. Always present at the top of the repos grid
// (repos.json is regenerated from GitHub each build; this card is curated).
import { t } from '../i18n';

interface Props {
  locale: 'en' | 'zh';
}
const { locale } = Astro.props;
const url = 'https://chat.finddatatech.cloud';
---

<li class="card card-live">
  <a class="card-main" href={url} target="_blank" rel="noopener noreferrer">
    <span class="name">chat.finddatatech.cloud</span>
    <span class="desc">{t(locale, 'repos.chatDesc')}</span>
    <span class="meta">LibreChat · MCP</span>
  </a>
  <span class="live-pill" aria-hidden="true">LIVE</span>
</li>
