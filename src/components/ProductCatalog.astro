---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';
import { PRODUCT_LINES, LADDER_CHARS, type ProductLine } from '../content.config';
import LineMark from './LineMark.astro';

interface Props {
  locale: string;
  line: ProductLine;
}

const { locale, line } = Astro.props;
// Pinyin secondary labels tie the English line names back to the Chinese
// identity (寻数·壹座 → Yizuo); shown on EN pages only.
const PINYIN: Record<ProductLine, string> = {
  base: 'Yizuo',
  lex: 'Shilü',
  wire: 'Baixun',
  facet: 'Qianmian',
  constellation: 'Wanxing',
};
// Hand-written entries, one file per app per locale (<locale>/<slug>.md);
// the active tab lists only its own line.
const apps = (await getCollection('apps'))
  .filter((a) => a.id.startsWith(`${locale}/`) && a.data.line === line)
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));
// App slug = filename under the locale dir (en/<slug>.md → <slug>).
const slugOf = (a) => a.id.split('/')[1];
const title = t(locale, 'apps.title') + ' — FindData Technology';
---

<Layout locale={locale} title={title} description={t(locale, 'apps.sub')}>
  <h1 class="page">{t(locale, 'apps.title')}</h1>
  <p class="page-sub">{t(locale, 'apps.sub')}</p>
  <div class="ladder">
    <p class="ladder-body">{t(locale, 'apps.ladder.body')}</p>
    <p class="ladder-brand">{t(locale, 'apps.ladder.brand')}</p>
  </div>
  <nav class="line-tabs" aria-label={t(locale, 'apps.title')}>
    {
      PRODUCT_LINES.map((l) => (
        <a href={getRelativeLocaleUrl(locale, `products/${l}`)} class={l === line ? 'active' : ''} aria-current={l === line ? 'page' : undefined}>
          <LineMark char={LADDER_CHARS[PRODUCT_LINES.indexOf(l)]} name={t(locale, `line.${l}` as const)} size="xs" />
          <span>{t(locale, `line.${l}` as const)}</span>
          {locale === 'en' && <span class="tab-pin"> · {PINYIN[l]}</span>}
          {l === 'constellation' && <span class="tab-tag"> · {t(locale, 'line.constellation.tag')}</span>}
        </a>
      ))
    }
  </nav>
  {
    // wire line only: entry to the Baixun B2B platform (wire-platform-v1).
    // Pure external link — the site renders identically whether or not the
    // target is reachable (no runtime dependency).
    line === 'wire' && (
      <a class="demo-cta" href="https://wire.finddatatech.cloud" target="_blank" rel="noopener noreferrer">
        <span class="demo-cta-label">▶ {t(locale, 'apps.wire.entry')}</span>
        <span class="demo-cta-sub">{t(locale, 'apps.wire.entry.sub')}</span>
      </a>
    )
  }
  {
    // wire line only: entry to the open data catalog (/data) — the line's
    // data surfaces stay discoverable after leaving the header (ia-lean).
    line === 'wire' && (
      <a class="demo-cta" href={getRelativeLocaleUrl(locale, 'data')}>
        <span class="demo-cta-label">▶ {t(locale, 'data.entry')}</span>
        <span class="demo-cta-sub">{t(locale, 'data.sub')}</span>
      </a>
    )
  }
  {
    // lex line only: entry to the Shilü legal platform (lex-platform-v1).
    // Pure external link — the site renders identically whether or not the
    // target is reachable (no runtime dependency).
    line === 'lex' && (
      <a class="demo-cta" href="https://lex.finddatatech.cloud" target="_blank" rel="noopener noreferrer">
        <span class="demo-cta-label">▶ {t(locale, 'apps.lex.entry')}</span>
        <span class="demo-cta-sub">{t(locale, 'apps.lex.entry.sub')}</span>
      </a>
    )
  }
  <ul class:list={['grid', { 'grid--feature': apps.length > 0 && apps.length <= 2 }]}>
    {
      apps.map((a) => (
        <li class="card">
          <a class="card-main" href={getRelativeLocaleUrl(locale, `products/${slugOf(a)}`)}>
            <span class="name">{a.data.name}</span>
            <span class="desc">{a.data.tagline}</span>
            <span class="meta">{[a.data.kind, a.data.demoUrl ? t(locale, 'apps.cta') : ''].filter(Boolean).join(' · ')}</span>
          </a>
        </li>
      ))
    }
  </ul>
  {!apps.length && <p class="page-sub">{t(locale, 'apps.empty')}</p>}
</Layout>

<style>
  .line-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 24px;
  }
  .line-tabs a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.85rem;
    letter-spacing: 1px;
    padding: 5px 14px 5px 8px;
    border-radius: 999px;
    color: var(--muted);
    border: 1px solid var(--border);
    text-decoration: none;
  }
  .line-tabs a.active { padding-left: 8px; }
  .line-tabs a:hover {
    color: var(--text);
    border-color: var(--border-strong);
    text-decoration: none;
  }
  .line-tabs a.active {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(56, 225, 200, 0.08);
    font-weight: 700;
  }
  .tab-pin {
    opacity: 0.7;
    font-weight: 400;
  }
  .tab-tag {
    opacity: 0.8;
    font-weight: 400;
  }
  .ladder {
    margin: 0 0 24px;
    padding: 14px 18px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .ladder-body {
    margin: 0 0 6px;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .ladder-brand {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
</style>
