---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';
import { type ProductLine } from '../content.config';
import LineTabs from './LineTabs.astro';
import constellationStatus from '../data/constellation-status.json';

interface Props {
  locale: string;
  line: ProductLine;
}

const { locale, line } = Astro.props;
// Hand-written entries, one file per app per locale (<locale>/<slug>.md);
// the active tab lists only its own line.
const apps = (await getCollection('apps'))
  .filter((a) => a.id.startsWith(`${locale}/`) && a.data.line === line)
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));
// 萬星 line entry strip (surface-constellation-entry-strip): the line's four
// products share one platform, so the line page needs ONE place to enter it.
// Figures come from the build-time snapshot; a missing figure is omitted, never
// rendered as 0 (a fresh checkout with an empty export must not claim "0 agents").
// `stale` is never true here — the exporter drops the whole file on failure, so
// an older snapshot is honest on its own generated_at.
const WANXING = 'https://wanxing.finddatatech.cloud';
const cxStatus = line === 'constellation'
  ? {
      agents: Number.isFinite(constellationStatus?.agents) ? constellationStatus.agents : null,
      turns7d: Number.isFinite(constellationStatus?.turns7d) ? constellationStatus.turns7d : null,
      at: typeof constellationStatus?.generated_at === 'string' ? constellationStatus.generated_at.slice(0, 10) : null,
    }
  : null;
// App slug = filename under the locale dir (en/<slug>.md → <slug>).
const slugOf = (a) => a.id.split('/')[1];
const title = t(locale, 'apps.title') + ' — FindData Technology';
---

<Layout locale={locale} title={title} description={t(locale, 'apps.sub')}>
  <h1 class="page">{t(locale, 'apps.title')}</h1>
  <p class="page-sub">{t(locale, 'apps.sub')}</p>
  <div class="ladder">
    <p class="ladder-body">{t(locale, 'apps.ladder.body')}</p>
    <p class="ladder-brand">{t(locale, 'apps.ladder.brand')}</p>
  </div>
  <LineTabs locale={locale} line={line} />
  {
    // wire line only: entry to the Baixun B2B platform (wire-platform-v1).
    // Pure external link — the site renders identically whether or not the
    // target is reachable (no runtime dependency). The pricing CTA is a
    // secondary outline button in the same group (One Signal rule: no extra
    // mint emphasis); the platform's pricing page is the single source of
    // pricing numbers, so none are carried here.
    line === 'wire' && (
      <div class="wire-entry">
        <a class="demo-cta" href="https://wire.finddatatech.cloud" target="_blank" rel="noopener noreferrer">
          <span class="demo-cta-label">▶ {t(locale, 'apps.wire.entry')}</span>
          <span class="demo-cta-sub">{t(locale, 'apps.wire.entry.sub')}</span>
        </a>
        <a class="button button-secondary" href="https://wire.finddatatech.cloud/#/pricing" target="_blank" rel="noopener noreferrer">
          {t(locale, 'apps.wire.entry.pricing')}
        </a>
      </div>
    )
  }
  {
    // wire line only: entry to the open data catalog (/data) — the line's
    // data surfaces stay discoverable after leaving the header (ia-lean).
    line === 'wire' && (
      <a class="demo-cta" href={getRelativeLocaleUrl(locale, 'data')}>
        <span class="demo-cta-label">▶ {t(locale, 'data.entry')}</span>
        <span class="demo-cta-sub">{t(locale, 'data.sub')}</span>
      </a>
    )
  }
  {
    // lex line only (lex-family-rebrand): the family manifesto, not a
    // line-level entry CTA — the five family members below are peers, and
    // the platform entry lives on the LiangLü card's own demoUrl.
    line === 'lex' && (
      <p class="page-sub">{t(locale, 'line.lex.desc')}</p>
    )
  }
  {
    // 萬星 line only (surface-constellation-entry-strip): the line page used to
    // end at four app cards with no line-level way in. Three entries into the
    // platform itself, plus the two running figures — a static page carrying a
    // live-ish readout needs to say when it was taken, so the snapshot date is
    // printed beside them.
    cxStatus && (
      <div class="wire-entry" data-testid="constellation-entry-strip">
        <div class="cx-entries">
          <a class="demo-cta" href={`${WANXING}/#/catalog`} target="_blank" rel="noopener noreferrer">
            <span class="demo-cta-label">▶ {t(locale, 'cx.entry.catalog')}</span>
            <span class="demo-cta-sub">{t(locale, 'cx.entry.catalog.sub')}</span>
          </a>
          <p class="cx-links">
            <a class="button button-secondary" href={`${WANXING}/#/docs`} target="_blank" rel="noopener noreferrer">
              {t(locale, 'cx.entry.docs')}
            </a>
            <a class="button button-secondary" href={`${WANXING}/#/console`} target="_blank" rel="noopener noreferrer">
              {t(locale, 'cx.entry.console')}
            </a>
          </p>
        </div>
        {(cxStatus.agents !== null || cxStatus.turns7d !== null) && (
          <p class="cx-figures">
            {cxStatus.agents !== null && (
              <span><b>{cxStatus.agents}</b> {t(locale, 'cx.figures.agents')}</span>
            )}
            {cxStatus.turns7d !== null && (
              <span><b>{cxStatus.turns7d}</b> {t(locale, 'cx.figures.turns')}</span>
            )}
            {cxStatus.at && <span class="cx-asof">{t(locale, 'cx.figures.asOf')} {cxStatus.at}</span>}
          </p>
        )}
      </div>
    )
  }
  <ul class:list={['grid', { 'grid--feature': apps.length > 0 && apps.length <= 2 }]}>
    {
      apps.map((a) => (
        <li class="card">
          <a class="card-main" href={getRelativeLocaleUrl(locale, `products/${slugOf(a)}`)}>
            <span class="name">{a.data.name}</span>
            {/* 成熟度标注（spec lex-family-branding「家族成员平级呈现」）：
                平级不等于同等成熟。词表与真源 fd-lex/docs/product-lineup.json
                的 members[].availability 一致；缺省不显示，避免给未见过的档位编词。 */}
            {a.data.availability && (
              <span class:list={['maturity', `maturity--${a.data.availability}`]}>
                {t(locale, `apps.maturity.${a.data.availability}`)}
              </span>
            )}
            <span class="desc">{a.data.tagline}</span>
            <span class="meta">{[a.data.kind, a.data.demoUrl ? t(locale, 'apps.cta') : ''].filter(Boolean).join(' · ')}</span>
          </a>
        </li>
      ))
    }
  </ul>
  {!apps.length && <p class="page-sub">{t(locale, 'apps.empty')}</p>}
</Layout>

<style>
  /* wire platform entry group: primary demo-cta strip + pricing outline
     button directly beneath (same visual group, no extra mint emphasis). */
  .wire-entry {
    margin-bottom: 28px;
  }
  .wire-entry .demo-cta {
    margin-bottom: 0;
  }
  .wire-entry .button-secondary {
    margin-top: 10px;
  }
  /* 萬星入口带（surface-constellation-entry-strip）：复用 wire-entry 的间距与按钮，
     只加两件事——两个次按钮并排，以及一行等宽的运行数字。 */
  .cx-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 10px 0 0;
  }
  .cx-links .button-secondary {
    margin-top: 0;
  }
  .cx-figures {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 18px;
    margin: 12px 0 0;
    font-size: var(--fs-mono);
    color: var(--muted);
  }
  .cx-figures b {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .cx-asof {
    font-size: 0.75rem;
    color: var(--muted);
    opacity: 0.75;
  }
  .ladder {
    margin: 0 0 24px;
    padding: 14px 18px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .ladder-body {
    margin: 0 0 6px;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .ladder-brand {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  /* 成熟度标注：同一形态、同一位置的三个档位。颜色只表达"能不能买"，
     不做等级褒贬；孵化态用中性灰，避免把"还没商业化"画成"差"。 */
  .maturity {
    display: inline-block;
    margin-top: 6px;
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.72rem;
    letter-spacing: 0.4px;
    line-height: 1.6;
    color: var(--text-soft);
    background: var(--bg-soft);
  }
  .maturity--live {
    border-color: color-mix(in srgb, var(--accent, #a6402f) 40%, var(--border));
    color: var(--accent, #a6402f);
  }
  .maturity--preview {
    border-style: dashed;
  }
</style>
