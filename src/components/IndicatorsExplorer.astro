---
// Shared indicators explorer: stats strip, distribution dashboard (SVG charts),
// instant client-side search, and a drill-down detail view with a sample-series
// line chart. Used by /indicators and /zh/indicators — locale-aware via t().
import { t } from '../i18n';
// Generated by scripts/fetch-indicators.mjs (committed snapshot = offline fallback).
import data from '../data/indicators.json';

interface Props {
  locale: 'en' | 'zh';
}
const { locale } = Astro.props;

interface Concept {
  id: number;
  code: string;
  name_en: string | null;
  name_zh: string | null;
  category: string | null;
  unit: string | null;
  measure: string | null;
  frequency: string | null;
  entity_type: string | null;
  source: string | null;
  sample?: { entity: string; points: [string, string][] };
}

const concepts = (data.concepts ?? []) as Concept[];
const counts = (key: keyof Concept) => {
  const m = new Map<string, number>();
  for (const c of concepts) {
    const k = (c[key] as string) || '—';
    m.set(k, (m.get(k) ?? 0) + 1);
  }
  return [...m.entries()].map(([label, value]) => ({ label, value })).sort((a, b) => b.value - a.value);
};

const stats = [
  { n: concepts.length, label: t(locale, 'indicators.stat.total') },
  { n: new Set(concepts.map((c) => c.category || '—')).size, label: t(locale, 'indicators.stat.categories') },
  { n: new Set(concepts.map((c) => c.source || '—')).size, label: t(locale, 'indicators.stat.sources') },
  { n: new Set(concepts.map((c) => c.entity_type || '—')).size, label: t(locale, 'indicators.stat.entityTypes') },
];

const strings = {
  empty: t(locale, 'indicators.empty'),
  more: t(locale, 'indicators.more'),
  sample: t(locale, 'indicators.sample'),
  noSample: t(locale, 'indicators.noSample'),
  tryLive: t(locale, 'indicators.tryLive'),
  labels: {
    category: t(locale, 'indicators.label.category'),
    unit: t(locale, 'indicators.label.unit'),
    measure: t(locale, 'indicators.label.measure'),
    frequency: t(locale, 'indicators.label.frequency'),
    entityType: t(locale, 'indicators.label.entityType'),
    source: t(locale, 'indicators.label.source'),
  },
};

// Embedded for the client script (charts + search + drill-down). `<` is escaped
// so the JSON is safe inside a <script type="application/json"> block.
const payload = JSON.stringify({
  concepts,
  dist: {
    category: counts('category'),
    entity_type: counts('entity_type'),
    frequency: counts('frequency'),
    source: counts('source'),
  },
  strings,
  demoHref: locale === 'zh' ? '/zh/demo' : '/demo',
}).replaceAll('<', '\\u003c');
---

<div class="stats" style="margin-top: 0; margin-bottom: 36px;">
  {stats.map((s) => <div class="stat"><b>{s.n}</b><span>{s.label}</span></div>)}
</div>

<div class="chart-grid">
  <div class="chart-card">
    <h3>{t(locale, 'indicators.byCategory')}</h3>
    <div class="chart-host" id="chart-category"></div>
  </div>
  <div class="chart-card">
    <h3>{t(locale, 'indicators.byEntity')}</h3>
    <div class="chart-host" id="chart-entity"></div>
  </div>
  <div class="chart-card">
    <h3>{t(locale, 'indicators.byFrequency')}</h3>
    <div class="chart-host" id="chart-frequency"></div>
  </div>
  <div class="chart-card">
    <h3>{t(locale, 'indicators.bySource')}</h3>
    <div class="chart-host" id="chart-source"></div>
  </div>
</div>

<div class="ind-search">
  <label class="sr-only" for="ind-search-input">{t(locale, 'indicators.searchPlaceholder')}</label>
  <input id="ind-search-input" type="search" autocomplete="off"
    placeholder={t(locale, 'indicators.searchPlaceholder')} />
</div>

<div id="ind-detail"></div>
<div class="ind-results" id="ind-results"></div>

<script type="application/json" id="ind-data" set:html={payload} />

<script>
  import { barChart, donutChart, lineChart, topN, escapeHtml } from '../scripts/indicators/charts';

  interface Concept {
    id: number;
    code: string;
    name_en: string | null;
    name_zh: string | null;
    category: string | null;
    unit: string | null;
    measure: string | null;
    frequency: string | null;
    entity_type: string | null;
    source: string | null;
    sample?: { entity: string; points: [string, string][] };
  }
  interface Payload {
    concepts: Concept[];
    dist: Record<'category' | 'entity_type' | 'frequency' | 'source', { label: string; value: number }[]>;
    strings: {
      empty: string;
      more: string;
      sample: string;
      noSample: string;
      tryLive: string;
      labels: Record<string, string>;
    };
    demoHref: string;
  }

  const payload: Payload = JSON.parse(document.getElementById('ind-data')?.textContent ?? '{}');
  const MAX_ROWS = 60;

  // ── Dashboard charts ──────────────────────────────────────────────────
  const host = (id: string) => document.getElementById(id);
  if (host('chart-category')) barChart(host('chart-category')!, topN(payload.dist.category, 12));
  if (host('chart-entity')) donutChart(host('chart-entity')!, topN(payload.dist.entity_type, 8));
  if (host('chart-frequency')) barChart(host('chart-frequency')!, payload.dist.frequency);
  if (host('chart-source')) barChart(host('chart-source')!, topN(payload.dist.source, 12));

  // ── Search + results ──────────────────────────────────────────────────
  const input = document.getElementById('ind-search-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('ind-results');
  const detailEl = document.getElementById('ind-detail');
  let selected: Concept | null = null;

  const matches = (c: Concept, q: string): boolean =>
    [c.code, c.name_en, c.name_zh].some((f) => (f ?? '').toLowerCase().includes(q));

  function rowHtml(c: Concept): string {
    const badges = [c.category, c.unit, c.frequency, c.source]
      .filter(Boolean)
      .map((b) => `<span>${escapeHtml(b ?? '')}</span>`)
      .join('');
    return `<button type="button" class="ind-row${selected?.id === c.id ? ' active' : ''}" data-id="${c.id}">
      <div class="code">${escapeHtml(c.code)}</div>
      <div class="names">${escapeHtml(c.name_en ?? '')}<span class="zh">${escapeHtml(c.name_zh ?? '')}</span></div>
      <div class="ind-badges">${badges}</div>
    </button>`;
  }

  function renderResults(): void {
    if (!resultsEl) return;
    const q = (input?.value ?? '').trim().toLowerCase();
    const list = q ? payload.concepts.filter((c) => matches(c, q)) : payload.concepts;
    if (!list.length) {
      resultsEl.innerHTML = `<p class="ind-empty">${escapeHtml(payload.strings.empty)}</p>`;
      return;
    }
    const shown = list.slice(0, MAX_ROWS);
    const extra = list.length - shown.length;
    resultsEl.innerHTML =
      shown.map(rowHtml).join('') + (extra > 0 ? `<p class="ind-more">+${extra} ${escapeHtml(payload.strings.more)}</p>` : '');
  }

  resultsEl?.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('.ind-row');
    const id = Number(row?.dataset.id);
    const c = payload.concepts.find((x) => x.id === id);
    if (c) {
      selected = c;
      renderDetail();
      renderResults();
      detailEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  input?.addEventListener('input', renderResults);

  // ── Drill-down detail ─────────────────────────────────────────────────
  function renderDetail(): void {
    if (!detailEl) return;
    if (!selected) {
      detailEl.innerHTML = '';
      return;
    }
    const c = selected;
    const L = payload.strings.labels;
    const rows: [string, string | null][] = [
      [L.category, c.category],
      [L.unit, c.unit],
      [L.measure, c.measure],
      [L.frequency, c.frequency],
      [L.entityType, c.entity_type],
      [L.source, c.source],
    ];
    detailEl.innerHTML = `<div class="ind-detail">
      <div class="head">
        <span class="code">${escapeHtml(c.code)}</span>
        <span class="name">${escapeHtml(c.name_en ?? '')}${c.name_zh ? ' · ' + escapeHtml(c.name_zh) : ''}</span>
        <button type="button" class="close" aria-label="close">✕</button>
      </div>
      <table class="ind-meta">
        ${rows
          .filter(([, v]) => v)
          .map(([k, v]) => `<tr><th>${escapeHtml(k)}</th><td>${escapeHtml(v ?? '')}</td></tr>`)
          .join('')}
      </table>
      ${
        c.sample?.points?.length
          ? `<h3>${escapeHtml(payload.strings.sample)}</h3><div class="chart-host" id="ind-sample-chart"></div>`
          : `<p class="no-sample">${escapeHtml(payload.strings.noSample)}</p>`
      }
      <a class="demo-link" href="${payload.demoHref}">${escapeHtml(payload.strings.tryLive)}</a>
    </div>`;
    detailEl.querySelector('.close')?.addEventListener('click', () => {
      selected = null;
      renderDetail();
      renderResults();
    });
    const chartHost = document.getElementById('ind-sample-chart');
    if (chartHost && c.sample?.points?.length) lineChart(chartHost, c.sample.points);
  }

  renderResults();
</script>
