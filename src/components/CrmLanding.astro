---
// CRM 服务板块落地页（crm-board-adoption 官网介绍，2026-10-23）。
// 定位：五线之上的服务板块——不占 LADDER/PRODUCT_LINES 契约，独立路由
// /crm 与 /zh/crm。文案双语内联在本组件（页面级营销文案与 UI 字典分离，
// 集中一处便于整块评审）；类名 crm-* 命名空间，样式 is:inline（同
// BaseLanding 的理由：不外链进其它页面）。
//
// 宣传口径纪律（品牌承诺「只说跑过的」）：只写实证过的能力（网站挂件已在本站
// 实跑、AI 接待 pack 已上谦面市场、自托管收件箱已上产），不写价格/客户案例/
// 用量数字；渠道范围如实（当前仅网站挂件）。
import Layout from './Layout.astro';

interface Props {
  locale: 'en' | 'zh';
}
const { locale } = Astro.props;

const CONTACT_EMAIL = '1253774197@qq.com';
const PACK_URL = 'https://facet.finddatatech.cloud/packs/eSMuaEbCjcQ0OkdGaGLbqA';

const S = {
  en: {
    kicker: 'FindData Desk · the service board',
    title: 'Every visitor question lands in one inbox — AI drafts, a human sends',
    sub: 'A self-hosted customer-service desk: a chat widget for your website, AI-drafted replies gated by human confirmation, and your data on your own infrastructure.',
    live: 'This page is running it — the chat bubble at the bottom-right corner is the very widget, serving our own site.',
    valuesTitle: 'What you get',
    values: [
      {
        h: 'Website widget',
        p: 'Visitors ask right where they are; every conversation lands in a shared inbox in real time. Live on this very site.',
      },
      {
        h: 'AI on draft, human on send',
        p: 'The AI receptionist reads the conversation and drafts a reply in your console. Nothing is sent until you confirm it — sending is gated, audited, and always yours.',
      },
      {
        h: 'Self-hosted inbox',
        p: 'Built on open-source Chatwoot, self-hosted on our infrastructure: per-tenant isolation, your data stays yours, sign-in through your FindData account.',
      },
    ],
    flowTitle: 'How a conversation goes',
    flow: [
      { h: 'Visitor asks', p: 'A question arrives from the widget on your site.' },
      { h: 'AI drafts', p: 'The receptionist reads the thread and writes a reply draft — never sends.' },
      { h: 'You confirm', p: 'One look, one click: approve the draft or write your own.' },
      { h: 'Delivery re-checked', p: 'After sending, the inbox is re-read to confirm the message landed.' },
    ],
    getTitle: 'Get started',
    marketH: 'From the marketplace',
    marketP: 'Install the CRM Reception Suite pack into your Base runtime and connect your desk.',
    marketCta: 'Open in the Facet marketplace',
    managedH: 'Managed desk',
    managedP: 'We provision and operate a desk for your team — accounts, widget script, and AI reception included.',
    managedCta: 'Contact us',
    scopeTitle: 'Scope, stated plainly',
    scope: [
      'One channel today: the website widget. We do not resell chat-channel bridges we have not run.',
      'Your conversations live in a tenant-isolated, self-hosted inbox. No pricing or usage numbers are shown on this page — nothing we have not actually run.',
      'AI suggestions are drafts by default; the send action always requires a human confirmation.',
    ],
    closingH: 'Questions? Ask the widget — or write to us.',
    closingP: 'The bubble below is the fastest route; a human reads every message.',
  },
  zh: {
    kicker: '寻数客服台 · 服务板块',
    title: '访客的每个提问都落进同一个收件箱——AI 起草，人工发送',
    sub: '自托管的客服台：一个网站挂件接待访客，AI 起草回复、发送必经人工确认，数据留在你自己的基础设施上。',
    live: '本页就在运行它——右下角的对话气泡就是产品本体，正服务着我们自己的官网。',
    valuesTitle: '你得到什么',
    values: [
      {
        h: '网站挂件',
        p: '访客在原地提问，每个会话实时落进共享收件箱。本站右下角就是实况。',
      },
      {
        h: 'AI 起草，人工发送',
        p: 'AI 客服读懂对话后在你的控制台里起草回复；不确认就不发送——发送动作有闸门、有审计，永远归你。',
      },
      {
        h: '自托管收件箱',
        p: '基于开源 Chatwoot 自托管：租户间相互隔离，数据归你，用寻数账号一键登录。',
      },
    ],
    flowTitle: '一段对话的旅程',
    flow: [
      { h: '访客提问', p: '来自你网站挂件的问题实时进箱。' },
      { h: 'AI 起草', p: '客服 AI 读懂上下文写出草稿——只草不发。' },
      { h: '你确认', p: '看一眼、点一下：采纳草稿，或者自己写。' },
      { h: '送达复核', p: '发送后回读收件箱，确认消息真的到了。' },
    ],
    getTitle: '怎么开始',
    marketH: '从市场安装',
    marketP: '把「CRM 客服接待套件」装进你的壹座运行时，接上你的客服台。',
    marketCta: '打开谦面市场',
    managedH: '托管开通',
    managedP: '我们为你的团队开通并运维客服台：账号、挂件脚本、AI 接待一并配好。',
    managedCta: '联系我们',
    scopeTitle: '边界，如实说',
    scope: [
      '当前渠道：网站挂件。没跑通的分发渠道我们不卖。',
      '会话存放在租户隔离的自托管收件箱。本页不展示价格与用量数字——没跑过的不写。',
      'AI 只起草；发送永远需要人工确认。',
    ],
    closingH: '有问题？问右下角挂件，或写信给我们。',
    closingP: '那个气泡是最快的通道，每条消息都有人读。',
  },
} as const;
const s = S[locale];
const title = (locale === 'zh' ? '寻数客服台' : 'FindData Desk') + ' — FindData Technology';
---

<Layout locale={locale} title={title} description={s.sub}>
  {/* ── 1 · hero ─────────────────────────────────────────────── */}
  <section class="crm-hero">
    <p class="crm-kicker">{s.kicker}</p>
    <h1>{s.title}</h1>
    <p class="crm-sub">{s.sub}</p>
    <p class="crm-live">
      <span class="crm-live-dot" aria-hidden="true"></span>
      {s.live}
    </p>
  </section>

  {/* ── 2 · values ───────────────────────────────────────────── */}
  <section class="crm-values">
    <h2>{s.valuesTitle}</h2>
    <ul class="grid">
      {
        s.values.map((v) => (
          <li class="card">
            <span class="name">{v.h}</span>
            <span class="why">{v.p}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ── 3 · flow ─────────────────────────────────────────────── */}
  <section class="crm-flow">
    <h2>{s.flowTitle}</h2>
    <ol class="crm-steps">
      {
        s.flow.map((f, i) => (
          <li class="crm-step">
            <span class="crm-step-num" aria-hidden="true">
              {i + 1}
            </span>
            <span class="crm-step-h">{f.h}</span>
            <span class="crm-step-p">{f.p}</span>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── 4 · get started ──────────────────────────────────────── */}
  <section class="crm-get">
    <h2>{s.getTitle}</h2>
    <div class="crm-tracks">
      <div class="crm-track">
        <h3>{s.marketH}</h3>
        <p>{s.marketP}</p>
        <a class="crm-cta" href={PACK_URL} target="_blank" rel="noopener noreferrer">
          {s.marketCta} ↗
        </a>
      </div>
      <div class="crm-track">
        <h3>{s.managedH}</h3>
        <p>{s.managedP}</p>
        <a class="crm-cta ghost" href={`mailto:${CONTACT_EMAIL}`}>{s.managedCta}</a>
      </div>
    </div>
  </section>

  {/* ── 5 · scope ────────────────────────────────────────────── */}
  <section class="crm-scope">
    <h2>{s.scopeTitle}</h2>
    <ul>
      {
        s.scope.map((line) => (
          <li>{line}</li>
        ))
      }
    </ul>
  </section>

  {/* ── 6 · closing ──────────────────────────────────────────── */}
  <section class="crm-closing">
    <h2>{s.closingH}</h2>
    <p>{s.closingP}</p>
    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
  </section>
</Layout>

<style is:inline>
  /* crm-* 命名空间；变量与全局类取自 /global.css（同 BaseLanding 手法） */
  .crm-hero { padding: 26px 0 8px; }
  .crm-kicker {
    margin: 0 0 14px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .crm-hero h1 {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    margin: 0 0 16px;
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 820px;
  }
  .crm-sub { color: var(--muted); max-width: 680px; margin: 0; font-size: 1.05rem; }
  .crm-live {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 18px 0 0;
    padding: 12px 16px;
    border: 1px dashed var(--border);
    border-radius: 12px;
    color: var(--text);
    font-size: 0.95rem;
    max-width: 640px;
  }
  .crm-live-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.18);
    flex: none;
    animation: crm-pulse 2.4s ease-in-out infinite;
  }
  @keyframes crm-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.18); }
    50% { box-shadow: 0 0 0 7px rgba(52, 211, 153, 0.08); }
  }

  .crm-values h2, .crm-flow h2, .crm-get h2, .crm-scope h2, .crm-closing h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin: 40px 0 14px;
  }
  .crm-values .card { min-height: 118px; }

  .crm-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .crm-step {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .crm-step-num {
    font-family: var(--mono);
    color: var(--accent);
    font-size: 0.8rem;
    letter-spacing: 1px;
  }
  .crm-step-h { font-weight: 700; }
  .crm-step-p { color: var(--muted); font-size: 0.92rem; }

  .crm-tracks { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .crm-track {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .crm-track h3 { margin: 0; font-size: 1.15rem; }
  .crm-track p { margin: 0; color: var(--muted); font-size: 0.95rem; max-width: 52ch; }
  .crm-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    background: var(--accent);
    color: #06201b;
    border-radius: 10px;
    padding: 11px 20px;
    font-weight: 700;
    white-space: nowrap;
  }
  .crm-cta:hover { text-decoration: none; filter: brightness(1.07); }
  .crm-cta.ghost { background: none; color: var(--text); border: 1px solid var(--border); }
  .crm-cta.ghost:hover { border-color: var(--accent); }

  .crm-scope ul { margin: 0; padding-left: 18px; color: var(--muted); }
  .crm-scope li { margin: 6px 0; max-width: 72ch; }

  .crm-closing { padding: 8px 0 40px; }
  .crm-closing p { color: var(--muted); margin: 0 0 10px; }
  .crm-closing a { font-family: var(--mono); }

  @media (max-width: 860px) {
    .crm-steps { grid-template-columns: 1fr 1fr; }
    .crm-tracks { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .crm-steps { grid-template-columns: 1fr; }
  }
</style>
