---
import { t } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  locale: string;
  title: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const other = locale === 'zh' ? 'en' : 'zh';
// Current path without the locale prefix, for the language-switch link.
const path = Astro.url.pathname.replace(/^\/zh(?=\/|$)/, '') || '/';

const nav = [
  { href: getRelativeLocaleUrl(locale, ''), label: t(locale, 'nav.home') },
  { href: getRelativeLocaleUrl(locale, 'repos'), label: t(locale, 'nav.repos') },
  { href: getRelativeLocaleUrl(locale, 'docs'), label: t(locale, 'nav.docs') },
  { href: getRelativeLocaleUrl(locale, 'roadmap'), label: t(locale, 'nav.roadmap') },
  { href: getRelativeLocaleUrl(locale, 'updates'), label: t(locale, 'nav.updates') },
  { href: getRelativeLocaleUrl(locale, 'demo'), label: t(locale, 'nav.demo') },
];
// ponytail: inline SVG, one path reused for both footer GitHub links
const ghPath =
  'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0016 8c0-4.42-3.58-8-8-8z';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/global.css" />
  </head>
  <body>
    <header class="site">
      <nav>
        <a class="brand" href={getRelativeLocaleUrl(locale, '')}>
          Find<em>Data</em>
        </a>
        <div class="nav-links">
          {
            nav.map((n) => (
              <a href={n.href}>{n.label}</a>
            ))
          }
        </div>
        <a class="lang" href={getRelativeLocaleUrl(other, path)}>{t(locale, 'switch.lang')}</a>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="site">
      <div class="inner">
        <span class="org">
          © {new Date().getFullYear()} <a href="https://github.com/FindDataTechnology">{t(locale, 'footer.org')}</a>
          <a class="gh" href="https://github.com/FindDataTechnology" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={ghPath} /></svg>
          </a>
        </span>
        <span>{t(locale, 'footer.line')}</span>
        <a class="gh" href="https://github.com/FindDataTechnology/fd-official-web" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={ghPath} /></svg>
          {t(locale, 'footer.viewSource')}
        </a>
        <a class="icp" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">粤ICP备2026118740号-1</a>
      </div>
    </footer>
  </body>
</html>
