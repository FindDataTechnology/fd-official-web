---
import Layout from '../components/Layout.astro';
import LineMark from '../components/LineMark.astro';
import LineTabs from '../components/LineTabs.astro';
import { PRODUCT_LINES, LADDER_CHARS, LADDER_NUMERALS } from '../content.config';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';

// 产品总览（official-web-surface-refresh D8）——/products 是五线目录，不是某条线
// 的落地页；壹座落地页在 /products/base。这里给阶梯叙事 + 五线卡 + tab 导航。
const locale = 'en';
const title = `${t(locale, 'apps.title')} — FindData Technology`;
---

<Layout locale={locale} title={title} description={t(locale, 'apps.sub')}>
  <h1 class="page">{t(locale, 'apps.title')}</h1>
  <p class="page-sub">{t(locale, 'apps.sub')}</p>

  <div class="ladder">
    <p class="ladder-body">{t(locale, 'apps.ladder.body')}</p>
    <p class="ladder-brand">{t(locale, 'apps.ladder.brand')}</p>
  </div>

  <LineTabs locale={locale} line="base" />

  <ul class="grid ladder-rail overview">
    {
      PRODUCT_LINES.map((l, i) => (
        <li class="card">
          <a class="card-main" href={getRelativeLocaleUrl(locale, `products/${l}`)}>
            <span class="rung-top">
              <LineMark char={LADDER_CHARS[i]} name={t(locale, `line.${l}`)} size="md" />
              <span class="rung-numeral" aria-hidden="true">
                {LADDER_NUMERALS[i]}
              </span>
            </span>
            <span class="name lines-name">{t(locale, `line.${l}`)}</span>
            <span class="why">{t(locale, `line.${l}.why`)}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {/* Service board (crm-board-adoption): the desk is a board above the five
     lines — its own landing at /crm, deliberately outside LADDER/PRODUCT_LINES. */}
  <section class="crm-board-entry">
    <h2>Service board</h2>
    <a class="card crm-board-card" href="/crm/">
      <span class="name lines-name">FindData Desk</span>
      <span class="why">Customer-service desk: website widget, AI-drafted replies with human-confirmed sending, self-hosted inbox. Live on this site — see the bubble at the bottom-right.</span>
    </a>
  </section>
</Layout>

<style>
  .overview {
    margin-top: 26px;
  }

  .crm-board-entry { margin-top: 30px; }
  .crm-board-entry h2 { font-family: var(--font-display); font-size: 1.2rem; margin: 0 0 12px; }
  .crm-board-card { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px; background: var(--panel); border: 1px solid var(--border); border-radius: 14px; color: var(--text); max-width: 560px; }
  .crm-board-card:hover { text-decoration: none; border-color: var(--accent); }
</style>
