---
import { getCollection, render } from 'astro:content';
import Layout from '../../../components/Layout.astro';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).filter((d) => d.id.startsWith('zh/'));
  return docs.map((d) => ({ params: { slug: d.id.slice(3) }, props: { doc: d } }));
}

const locale = 'zh';
const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Layout locale={locale} title={doc.data.title}>
  <a class="doc-back" href="/zh/docs">← {locale === 'en' ? 'All docs' : '全部文档'}</a>
  <article class="doc"><Content /></article>
</Layout>
