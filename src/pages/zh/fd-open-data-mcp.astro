---
import { getEntry, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { t } from '../../i18n';

const locale = 'zh';
const entry = await getEntry('flagship', 'zh');
if (!entry) throw new Error('flagship/zh.md missing');
const { Content } = await render(entry);
const title = `${entry.data.title} — FindData Technology`;
---

<Layout locale={locale} title={title} description={entry.data.tagline}>
  <article class="doc flagship">
    <h1>{entry.data.title}</h1>
    <p class="flagship-tagline">{entry.data.tagline}</p>
    <Content />
  </article>
</Layout>
