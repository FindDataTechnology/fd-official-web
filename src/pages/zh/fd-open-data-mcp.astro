---
import { getEntry, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
// 旗舰页数字与首页同源于构建期指标导出，两处永不打架（official-web-content-truth）。
import indicatorData from '../../data/indicators.json';

const locale = 'zh';
const entry = await getEntry('flagship', 'zh');
if (!entry) throw new Error('flagship/zh.md missing');
const { Content } = await render(entry);
const title = `${entry.data.title} — FindData Technology`;
const raw = indicatorData as { active_concepts?: number | null; tools_count?: number | null };
const statConcepts = raw.active_concepts ?? null;
const statTools = raw.tools_count ?? null;
const fmt = (n: number) => n.toLocaleString(locale);
---

<Layout locale={locale} title={title} description={entry.data.tagline}>
  <article class="doc flagship">
    <h1>{entry.data.title}</h1>
    <p class="flagship-tagline">{entry.data.tagline}</p>
    {
      statConcepts != null && statTools != null && (
        <p class="repo-meta">
          {fmt(statConcepts)} 个指标概念 · {fmt(statTools)} 个 MCP 工具 · 来自本次构建的指标导出
        </p>
      )
    }
    <Content />
    <p class="repo-meta">
      数据板块：<a href="/zh/data">浏览精选数据资产目录</a>
    </p>
        <p class="repo-meta">
      {locale === 'zh' ? '技术文档：' : 'Technical docs: '}
      [快速开始](/zh/docs/quickstart) · [协议概览](/zh/docs/protocol) · [接入数据源](/zh/docs/datasource)
    </p>
  </article>
</Layout>
