---
import ProductCatalog from '../../../components/ProductCatalog.astro';
import BaseLanding from '../../../components/BaseLanding.astro';
import { PRODUCT_LINES, type ProductLine } from '../../../content.config';

export async function getStaticPaths() {
  return PRODUCT_LINES.map((line) => ({ params: { line }, props: { line } }));
}

const { line } = Astro.props as { line: ProductLine };
---

{line === 'base' ? <BaseLanding locale="zh" /> : <ProductCatalog locale="zh" line={line} />}
