---
import { getCollection } from 'astro:content';

// 旧地址 /zh/apps/<slug> → /zh/products/<slug> 的重定向桩页(静态站用 meta 刷新)。
export async function getStaticPaths() {
  const apps = (await getCollection('apps')).filter((a) => a.id.startsWith('zh/'));
  return apps.map((a) => ({ params: { slug: a.id.split('/')[1] } }));
}

const slug = Astro.params.slug!;
const dest = `/zh/products/${slug}`;
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <title>正在跳转…</title>
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <link rel="canonical" href={dest} />
  </head>
  <body>
    <p>本页已迁移至 <a href={dest}>{dest}</a>。</p>
  </body>
</html>
