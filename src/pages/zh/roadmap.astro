---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Gantt from '../../components/Gantt.astro';
import { t } from '../../i18n';

const locale = 'zh';
const phases = (await getCollection('roadmap')).sort((a, b) => a.data.order - b.data.order);
const title = t(locale, 'roadmap.title') + ' — FindData Technology';

// Timeline: progress (mint) extends up to the last non-planned phase.
const currentIdx = Math.max(...phases.map((x, i) => (x.data.status !== 'planned' ? i : -1)));
---

<Layout locale={locale} title={title} description={t(locale, 'roadmap.sub')}>
  <h1 class="page">{t(locale, 'roadmap.title')}</h1>
  <p class="page-sub">{t(locale, 'roadmap.sub')}</p>
  <Gantt locale={locale} />
  <ol class="timeline">
    {
      phases.map((p, i) => (
        <li
          class:list={[
            'tl-phase',
            p.data.status,
            { reached: i <= currentIdx, 'next-reached': i < currentIdx },
          ]}
        >
          <div class="tl-axis"><span class="tl-node" /></div>
          <div class="tl-name">
            {p.data.name} <em>{p.data.pinyin}</em>
          </div>
          <div class:list={['phase', p.data.status]}>
            <div class="phase-head">
              <span class={`phase-status ${p.data.status}`}>{t(locale, `roadmap.status.${p.data.status}`)}</span>
            </div>
            <p class="phase-period">{p.data.period_zh}</p>
            <p class="phase-goal">{p.data.goal_zh}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Layout>
