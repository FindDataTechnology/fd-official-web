---
import Layout from '../../components/Layout.astro';
import LineMark from '../../components/LineMark.astro';
import LineTabs from '../../components/LineTabs.astro';
import { PRODUCT_LINES, LADDER_CHARS, LADDER_NUMERALS } from '../../content.config';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../../i18n';

// 产品总览（official-web-surface-refresh D8）——/zh/products 是五线目录，不是某条线
// 的落地页；壹座落地页在 /zh/products/base。这里给阶梯叙事 + 五线卡 + tab 导航。
const locale = 'zh';
const title = `${t(locale, 'apps.title')} — FindData Technology`;
---

<Layout locale={locale} title={title} description={t(locale, 'apps.sub')}>
  <h1 class="page">{t(locale, 'apps.title')}</h1>
  <p class="page-sub">{t(locale, 'apps.sub')}</p>

  <div class="ladder">
    <p class="ladder-body">{t(locale, 'apps.ladder.body')}</p>
    <p class="ladder-brand">{t(locale, 'apps.ladder.brand')}</p>
  </div>

  <LineTabs locale={locale} line="base" />

  <ul class="grid ladder-rail overview">
    {
      PRODUCT_LINES.map((l, i) => (
        <li class="card">
          <a class="card-main" href={getRelativeLocaleUrl(locale, `products/${l}`)}>
            <span class="rung-top">
              <LineMark char={LADDER_CHARS[i]} name={t(locale, `line.${l}`)} size="md" />
              <span class="rung-numeral" aria-hidden="true">
                {LADDER_NUMERALS[i]}
              </span>
            </span>
            <span class="name lines-name">{t(locale, `line.${l}`)}</span>
            <span class="why">{t(locale, `line.${l}.why`)}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {/* 服务板块（crm-board-adoption）：客服台是五线之上的板块，独立落地页 /zh/crm，
     有意不进 LADDER/PRODUCT_LINES 契约。 */}
  <section class="crm-board-entry">
    <h2>服务板块</h2>
    <a class="card crm-board-card" href="https://marketing.finddatatech.cloud/" target="_blank" rel="noopener noreferrer">
      <span class="name lines-name">寻数客服台</span>
      <span class="why">客服接待服务：网站挂件 + AI 起草（发送必经人工确认）+ 自托管收件箱。本站右下角气泡就是运行实况。</span>
    </a>
  </section>

  {/* 第二个板块（add-erp-domain 7.3）：ERP 是五线之上的板块，独立落地页
      /zh/erp，有意不进 LADDER/PRODUCT_LINES 契约。如实口径：只述真实能力、
      不写虚构数字，不宣称单体 ERP / 开票自研 / 资金执行 / 已上线。板块标签 +
      双语同形 ERP。 */}
  <section class="erp-board-entry">
    <h2>ERP 板块</h2>
    <a class="card erp-board-card" href={getRelativeLocaleUrl(locale, 'erp')}>
      <span class="name lines-name">ERP <span class="erp-board-tag">· 板块</span></span>
      <span class="why">账本内核 · 对账滩头——行业无关的复式事件账内核，加一个只读对账滩头；以「集群 + 供给包」组合交付，非单体 ERP 应用。资金归集 / 分账与开票走客户自有的持牌 / 合规渠道。</span>
    </a>
  </section>
</Layout>

<style>
  .overview {
    margin-top: 26px;
  }

  .crm-board-entry { margin-top: 30px; }
  .crm-board-entry h2 { font-family: var(--font-display); font-size: 1.2rem; margin: 0 0 12px; }
  .crm-board-card { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px; background: var(--panel); border: 1px solid var(--border); border-radius: 14px; color: var(--text); max-width: 560px; }
  .crm-board-card:hover { text-decoration: none; border-color: var(--accent); }

  .erp-board-entry { margin-top: 30px; }
  .erp-board-entry h2 { font-family: var(--font-display); font-size: 1.2rem; margin: 0 0 12px; }
  .erp-board-card { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px; background: var(--panel); border: 1px solid var(--border); border-radius: 14px; color: var(--text); max-width: 560px; }
  .erp-board-card:hover { text-decoration: none; border-color: var(--accent); }
  .erp-board-tag { opacity: 0.8; font-weight: 400; }
</style>
