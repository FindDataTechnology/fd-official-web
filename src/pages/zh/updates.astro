---
import Layout from '../../components/Layout.astro';
import LineMark from '../../components/LineMark.astro';
import { PRODUCT_LINES, LADDER_CHARS, REPO_LINES } from '../../content.config';
import { t } from '../../i18n';
// Generated at build time by scripts/fetch-repos.mjs (changelogs + commits).
import updatesJson from '../../data/updates.json';
// Public-only guard: the committed fallback can go stale — a repo may have
// turned private (or been deleted) since the last successful fetch. Drop any
// entry whose repo is absent from the committed public list, so a degraded
// build can never publish non-public repo activity.
import reposJson from '../../data/repos.json';

interface Entry {
  repo: string;
  url: string;
  version: string;
  date: string | null;
  upcoming: boolean;
  summary: string[];
}

const locale = 'zh';
const publicRepos = new Set(reposJson.repos.map((r: { name: string }) => r.name));
const entries: Entry[] = updatesJson.filter((e: Entry) => publicRepos.has(e.repo));
const title = t(locale, 'updates.title') + ' — FindData Technology';
---

<Layout locale={locale} title={title} description={t(locale, 'updates.sub')}>
  <h1 class="page">{t(locale, 'updates.title')}</h1>
  <p class="page-sub">{t(locale, 'updates.sub')}</p>
  {
    entries.length ? (
      <ol class="feed">
        {entries.map((e) => (
          <li class={e.upcoming ? 'upcoming' : ''}>
            <div class="feed-head">
              {REPO_LINES[e.repo] && (
                <LineMark
                  char={LADDER_CHARS[PRODUCT_LINES.indexOf(REPO_LINES[e.repo] as (typeof PRODUCT_LINES)[number])]}
                  name={t(locale, `line.${REPO_LINES[e.repo]}` as const)}
                  size="xs"
                />
              )}
              <a class="feed-repo" href={e.url} target="_blank" rel="noopener noreferrer">{e.repo}</a>
              <span class="feed-ver">{e.upcoming ? t(locale, 'updates.upcoming') : e.version}</span>
              {e.date && <time>{e.date}</time>}
            </div>
            <ul>
              {e.summary.map((s) => (
                <li set:html={s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>').replace(/`([^`]+)`/g, '<code>$1</code>')} />
              ))}
            </ul>
          </li>
        ))}
      </ol>
    ) : (
      <p class="page-sub">{t(locale, 'updates.empty')}</p>
    )
  }
</Layout>
