---
import Layout from '../components/Layout.astro';
import DataModulesExplorer from '../components/DataModulesExplorer.astro';
import { t } from '../i18n';
import snapshot from '../data/data-modules.json';

const locale = 'en';
const title = t(locale, 'data.title') + ' — FindData Technology';
---

<Layout locale={locale} title={title} description={t(locale, 'data.sub')}>
  <h1 class="page">{t(locale, 'data.title')}</h1>
  <p class="page-sub">{t(locale, 'data.sub')}</p>
  <DataModulesExplorer
    locale={locale}
    modules={snapshot.modules}
    coverage={snapshot.coverage}
    snapshotAsOf={snapshot.generated_at}
  />
</Layout>
