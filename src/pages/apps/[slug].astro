---
import { getCollection } from 'astro:content';

// Legacy /apps/<slug> → /products/<slug> redirect stub (meta-refresh; static
// hosting has no server rewrite, and Astro 7 config redirects take no paths).
export async function getStaticPaths() {
  const apps = (await getCollection('apps')).filter((a) => a.id.startsWith('en/'));
  return apps.map((a) => ({ params: { slug: a.id.split('/')[1] } }));
}

const slug = Astro.params.slug!;
const dest = `/products/${slug}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <link rel="canonical" href={dest} />
  </head>
  <body>
    <p>This page has moved to <a href={dest}>{dest}</a>.</p>
  </body>
</html>
