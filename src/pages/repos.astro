---
import Layout from '../components/Layout.astro';
import RepoCard, { type Repo } from '../components/RepoCard.astro';
import LineMark from '../components/LineMark.astro';
import { t } from '../i18n';
import { PRODUCT_LINES, LADDER_CHARS, LADDER_NUMERALS, REPO_LINES } from '../content.config';
// Bundled by Vite at build time (repos.json is generated by scripts/fetch-repos.mjs).
import reposJson from '../data/repos.json';

const locale = 'en';
const { generated_at: capturedAt, repos } = reposJson as { generated_at?: string; repos: Repo[] };
const featured = new Set(['fd-open-data-mcp', 'fd-open-data-protocol']);


const featuredRepos = repos.filter((r) => featured.has(r.name));
const groups = PRODUCT_LINES.map((line, i) => ({
  line,
  char: LADDER_CHARS[i],
  items: repos.filter((r) => !featured.has(r.name) && REPO_LINES[r.name] === line),
})).filter((g) => g.items.length > 0);
const other = repos.filter((r) => !featured.has(r.name) && !(r.name in REPO_LINES));

const title = t(locale, 'repos.title') + ' — FindData Technology';
const captured = capturedAt
  ? new Date(capturedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---

<Layout locale={locale} title={title} description={t(locale, 'repos.sub')}>
  <h1 class="page">{t(locale, 'repos.title')}</h1>
  <p class="page-sub">{t(locale, 'repos.sub')}</p>
  {
    repos.length ? (
      <>
        {captured && <p class="catalog-asof">{t(locale, 'repos.asOf').replace('{date}', captured)}</p>}
        <ul class="grid">
          {featuredRepos.map((r) => (
            <RepoCard repo={r} featured={true} locale={locale} />
          ))}
        </ul>
        {groups.map((g) => (
          <section class="repo-group">
            <h2 class="repo-group-head">
              <LineMark char={g.char} name={t(locale, `line.${g.line}`)} size="sm" />
              <span>{t(locale, `line.${g.line}`)}</span>
              <span class="count">{g.items.length}</span>
              <span class="rung-numeral group-numeral" aria-hidden="true">{LADDER_NUMERALS[PRODUCT_LINES.indexOf(g.line)]}</span>
            </h2>
            <ul class="grid">
              {g.items.map((r) => (
                <RepoCard repo={r} locale={locale} />
              ))}
            </ul>
          </section>
        ))}
        {other.length > 0 && (
          <section class="repo-group">
            <h2 class="repo-group-head">
              <span>{t(locale, 'repos.other')}</span>
              <span class="count">{other.length}</span>
            </h2>
            <ul class="grid">
              {other.map((r) => (
                <RepoCard repo={r} locale={locale} />
              ))}
            </ul>
          </section>
        )}
      </>
    ) : (
      <p class="page-sub">{t(locale, 'repos.empty')}</p>
    )
  }
</Layout>
