---
import Layout from '../components/Layout.astro';
import RepoCard, { type Repo } from '../components/RepoCard.astro';
import DemoCta from '../components/DemoCta.astro';
import LiveChatCard from '../components/LiveChatCard.astro';
import { t } from '../i18n';
import { site } from '../config';
// Bundled by Vite at build time (repos.json is generated by scripts/fetch-repos.mjs).
import reposJson from '../data/repos.json';

const locale = 'en';
const repos: Repo[] = reposJson;
const featured = new Set(site.featured);
const title = t(locale, 'repos.title') + ' — FindData Technology';
---

<Layout locale={locale} title={title} description={t(locale, 'repos.sub')}>
  <h1 class="page">{t(locale, 'repos.title')}</h1>
  <p class="page-sub">{t(locale, 'repos.sub')}</p>
  <DemoCta locale={locale} />
  <ul class="grid">
    <LiveChatCard locale={locale} />
    {repos.map((r) => <RepoCard repo={r} featured={featured.has(r.name)} locale={locale} />)}
  </ul>
  {!repos.length && <p class="page-sub">{t(locale, 'repos.empty')}</p>}
</Layout>
