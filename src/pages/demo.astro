---
import Layout from '../components/Layout.astro';
import TourMockup from '../components/TourMockup.astro';
import TourTrial from '../components/TourTrial.astro';
import { t } from '../i18n';

const locale = 'en';
const PLATFORM_URL = 'https://craw.finddatatech.cloud';

const title = t(locale, 'demo.title') + ' — FindData Technology';

// One consistent icon voice: 1.4px stroke, currentColor, 20px box.
const icons = {
  chat: 'M2.5 4.5A2 2 0 014.5 2.5h7a2 2 0 012 2v4a2 2 0 01-2 2H8l-3 2.5v-2.5h-.5a2 2 0 01-2-2v-4z M13.5 6.5v2a3 3 0 01-3 3H7.5',
  doc: 'M4 1.5h5.5L12.5 4.5V14a.5.5 0 01-.5.5H4a.5.5 0 01-.5-.5V2a.5.5 0 01.5-.5z M9.5 1.5V4.5H12.5 M6 8h4 M6 10.5h4',
  nodes: 'M3 4.5h4.5v3H3v-3z M8.5 10.5H13v3H8.5v-3z M5.25 7.5v2.25a1 1 0 001 1h2.25',
  box: 'M2.5 5.5L8 3l5.5 2.5v5L8 13l-5.5-2.5v-5z M2.5 5.5L8 8l5.5-2.5 M8 8v5',
};
const features = [
  { icon: icons.chat, title: t(locale, 'demo.f1.title'), body: t(locale, 'demo.f1.body') },
  { icon: icons.doc, title: t(locale, 'demo.f2.title'), body: t(locale, 'demo.f2.body') },
  { icon: icons.nodes, title: t(locale, 'demo.f3.title'), body: t(locale, 'demo.f3.body') },
  { icon: icons.box, title: t(locale, 'demo.f4.title'), body: t(locale, 'demo.f4.body') },
];
---

<Layout locale={locale} title={title} description={t(locale, 'demo.sub')}>
  <section class="tour-hero">
    <div class="tour-copy">
      <h1>{t(locale, 'demo.hero.title')}</h1>
      <p class="sub">{t(locale, 'demo.hero.sub')}</p>
      <a class="tour-cta" href={PLATFORM_URL} target="_blank" rel="noopener noreferrer">
        {t(locale, 'demo.cta')}
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 3h7v7M13 3L5.5 10.5M11 9v4H2V4h4" />
        </svg>
      </a>
      <p class="cta-note">{t(locale, 'demo.cta.note')}</p>
    </div>
    <TourMockup locale={locale} />
  </section>

  <section class="tour-features">
    <h2>{t(locale, 'demo.features.title')}</h2>
    <div class="tour-rows">
      {
        features.map((f) => (
          <div class="tour-row">
            <svg class="tour-ico" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
              <path d={f.icon} />
            </svg>
            <div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <TourTrial locale={locale} />
</Layout>
