---
import { getEntry, render } from 'astro:content';
import Layout from '../components/Layout.astro';
// Flagship figures come from the same build-time indicator export the homepage
// uses, so the two surfaces can never disagree (official-web-content-truth).
import indicatorData from '../data/indicators.json';

const locale = 'en';
const entry = await getEntry('flagship', 'en');
if (!entry) throw new Error('flagship/en.md missing');
const { Content } = await render(entry);
const title = `${entry.data.title} — FindData Technology`;
const raw = indicatorData as { active_concepts?: number | null; tools_count?: number | null };
const statConcepts = raw.active_concepts ?? null;
const statTools = raw.tools_count ?? null;
const fmt = (n: number) => n.toLocaleString(locale);
---

<Layout locale={locale} title={title} description={entry.data.tagline}>
  <article class="doc flagship">
    <h1>{entry.data.title}</h1>
    <p class="flagship-tagline">{entry.data.tagline}</p>
    {
      statConcepts != null && statTools != null && (
        <p class="repo-meta">
          {fmt(statConcepts)} indicator concepts · {fmt(statTools)} MCP tools · from this build's indicator export
        </p>
      )
    }
    <Content />
    <p class="repo-meta">
      {locale === 'zh' ? '技术文档：' : 'Technical docs: '}
      [Quickstart](/docs/quickstart) · [Protocol](/docs/protocol) · [Datasource](/docs/datasource)
    </p>
  </article>
</Layout>
