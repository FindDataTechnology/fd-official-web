---
import { getEntry, render } from 'astro:content';
import Layout from '../components/Layout.astro';
import { t } from '../i18n';

const locale = 'en';
const entry = await getEntry('flagship', 'en');
if (!entry) throw new Error('flagship/en.md missing');
const { Content } = await render(entry);
const title = `${entry.data.title} — FindData Technology`;
---

<Layout locale={locale} title={title} description={entry.data.tagline}>
  <article class="doc flagship">
    <h1>{entry.data.title}</h1>
    <p class="flagship-tagline">{entry.data.tagline}</p>
    <Content />
  </article>
</Layout>
