---
import { render } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import XingyanEntry from '../../../components/XingyanEntry.astro';
import XingyanJsonLd from '../../../components/XingyanJsonLd.astro';
import { t } from '../../../i18n';
import { loadXingyanSurface, slugOf, type XingyanLocale } from '../../../lib/xingyan';

// 内参 detail — /research/briefings/<slug>. Loading runs the twins gate, so a
// briefing without its zh counterpart fails the build before any page is
// written (lib/xingyan.ts).
export async function getStaticPaths() {
  const { briefings } = await loadXingyanSurface();
  return briefings.en.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const locale: XingyanLocale = 'en';
const { entry } = Astro.props;
const { Content } = await render(entry);
const title = `${entry.data.title} — FindData Technology`;
---

<Layout locale={locale} title={title} description={entry.data.summary}>
  <XingyanJsonLd
    locale={locale}
    site={Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.finddatatech.cloud'}
    title={entry.data.title}
    summary={entry.data.summary}
    path={`/research/briefings/${slugOf(entry)}`}
    twinPath={`/zh/research/briefings/${slugOf(entry)}`}
    date={entry.data.date}
    updated={entry.data.updated}
    level={entry.data.level === 'use' || entry.data.level === 'build' ? entry.data.level : undefined}
    sources={entry.data.sources}
    schemaType="Article"
  />
  <XingyanEntry
    locale={locale}
    backHref="/research#briefings"
    backLabel={t(locale, 'research.back')}
    title={entry.data.title}
    summary={entry.data.summary}
    date={entry.data.date}
    tags={entry.data.tags}
    sources={entry.data.sources}
  >
    <Content />
  </XingyanEntry>
</Layout>
