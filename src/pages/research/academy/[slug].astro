---
import { render } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import XingyanEntry from '../../../components/XingyanEntry.astro';
import XingyanJsonLd from '../../../components/XingyanJsonLd.astro';
import { t } from '../../../i18n';
import { loadXingyanSurface, slugOf, type XingyanLocale } from '../../../lib/xingyan';

// 学院 course page — /research/academy/<slug>. The web course is canonical;
// the matching Facet-market pack is linked from frontmatter (pack_url), or
// flagged as still being prepared when the pack has not shipped yet.
export async function getStaticPaths() {
  const { courses } = await loadXingyanSurface();
  return courses.en.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const locale: XingyanLocale = 'en';
const { entry } = Astro.props;
const { Content } = await render(entry);
const title = `${entry.data.title} — FindData Technology`;
---

<Layout locale={locale} title={title} description={entry.data.summary}>
  <XingyanJsonLd
    locale={locale}
    site={Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.finddatatech.cloud'}
    title={entry.data.title}
    summary={entry.data.summary}
    path={`/research/academy/${slugOf(entry)}`}
    twinPath={`/zh/research/academy/${slugOf(entry)}`}
    date={entry.data.date}
    updated={entry.data.updated}
    level={entry.data.level === 'use' || entry.data.level === 'build' ? entry.data.level : undefined}
    sources={entry.data.sources}
    schemaType="Course"
  />
  <XingyanEntry
    locale={locale}
    backHref="/research#academy"
    backLabel={t(locale, 'research.back')}
    title={entry.data.title}
    summary={entry.data.summary}
    sourceMaterial={entry.data.source_material}
    packUrl={entry.data.pack_url}
    tier={entry.data.level === 'use' || entry.data.level === 'build' ? entry.data.level : undefined}
    updated={entry.data.updated}
  >
    <Content />
  </XingyanEntry>
</Layout>
