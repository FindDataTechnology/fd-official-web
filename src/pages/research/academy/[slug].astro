---
import { render } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import XingyanEntry from '../../../components/XingyanEntry.astro';
import { t } from '../../../i18n';
import { loadXingyanSurface, slugOf, type XingyanLocale } from '../../../lib/xingyan';

// 学院 course page — /research/academy/<slug>. The web course is canonical;
// the matching Facet-market pack is linked from frontmatter (pack_url), or
// flagged as still being prepared when the pack has not shipped yet.
export async function getStaticPaths() {
  const { courses } = await loadXingyanSurface();
  return courses.en.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const locale: XingyanLocale = 'en';
const { entry } = Astro.props;
const { Content } = await render(entry);
const title = `${entry.data.title} — FindData Technology`;
---

<Layout locale={locale} title={title} description={entry.data.summary}>
  <XingyanEntry
    locale={locale}
    backHref="/research#academy"
    backLabel={t(locale, 'research.back')}
    title={entry.data.title}
    summary={entry.data.summary}
    sourceMaterial={entry.data.source_material}
    packUrl={entry.data.pack_url}
  >
    <Content />
  </XingyanEntry>
</Layout>
