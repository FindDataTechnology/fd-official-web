---
import { getCollection } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import { t, type UiKey } from '../../../i18n';
import { splitByLocale, checkLocaleTwins } from '../../../lib/twins';

// 学院索引页（official-web-surface-refresh）——只渲染元数据，正文留在详情页。
// 落地页只出精选，完整清单来这里。
const locale = 'en';
const courses = await getCollection('academy');
const split = splitByLocale(courses);
checkLocaleTwins('academy', 'course', split, (e) => e.id.split('/')[1] ?? e.id);
const list = split.en.sort(
  (a, b) => (a.data.order ?? 10) - (b.data.order ?? 10) || a.id.localeCompare(b.id),
);

const TIER_ORDER = ['use', 'build', 'undeclared'] as const;
const tierOf = (e: (typeof list)[number]) =>
  e.data.level === 'use' || e.data.level === 'build' ? e.data.level : 'undeclared';
const groups = TIER_ORDER.map((tier) => ({
  tier,
  list: list.filter((e) => tierOf(e) === tier),
})).filter((g) => g.list.length > 0);

const title = `${t(locale, 'research.academy.title')} — FindData Technology`;
---

<Layout locale={locale} title={title} description={t(locale, 'research.academy.sub')}>
  <a class="doc-back" href="/research#academy">← {t(locale, 'research.back')}</a>
  <h1 class="page">{t(locale, 'research.academy.title')}</h1>
  <p class="page-sub">{t(locale, 'research.academy.sub')}</p>
  {
    groups.map((group) => (
      <section class="idx-group">
        <h2 class="idx-group-title">
          {t(locale, `research.academy.tier.${group.tier}` as UiKey)}
        </h2>
        <p class="idx-group-sub">
          {t(locale, `research.academy.tier.${group.tier}.sub` as UiKey)}
        </p>
        <ul class="idx-list">
          {group.list.map((course) => (
            <li class="idx-item">
              <a class="idx-title" href={`/research/academy/${course.id.split('/')[1]}`}>
                {course.data.title}
              </a>
              {course.data.updated && (
                <span class="idx-meta">
                  {t(locale, 'research.course.updated')}{' '}
                  <time datetime={course.data.updated}>{course.data.updated}</time>
                </span>
              )}
              <p class="idx-sum">{course.data.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>

<style>
  .idx-group + .idx-group {
    border-top: 1px solid var(--border);
    margin-top: 28px;
    padding-top: 22px;
  }
  .idx-group-title {
    font-size: 1.05rem;
    margin: 0 0 3px;
  }
  .idx-group-sub {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0 0 14px;
  }
  .idx-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 78ch;
  }
  .idx-item + .idx-item {
    border-top: 1px solid var(--border);
    margin-top: 14px;
    padding-top: 14px;
  }
  .idx-title {
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 700;
  }
  .idx-title:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .idx-meta {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.74rem;
    margin-left: 10px;
  }
  .idx-sum {
    color: var(--muted);
    font-size: 0.94rem;
    margin: 4px 0 0;
  }
</style>
