---
import Layout from '../components/Layout.astro';
import { t } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';
import { PRODUCT_LINES } from '../content.config';
// Homepage stats derive at build from the same indicator export the
// /indicators page serves, so the two surfaces can never disagree. The
// export runs at every build (scripts/fetch-indicators.mjs), with the
// committed snapshot as offline fallback.
import indicatorData from '../data/indicators.json';

const locale = 'en';
const title = 'FindData Technology — An ecosystem for text and data';
const phases = (await getCollection('roadmap')).sort((a, b) => a.data.order - b.data.order);
const concepts = (indicatorData as { concepts?: Array<{ source?: string | null }> }).concepts ?? [];
const statIndicators = concepts.length;
const statSources = new Set(concepts.map((c) => c.source || '—')).size;
const statTools = (indicatorData as { tools_count?: number | null }).tools_count ?? null;
---

<Layout locale={locale} title={title} description={t(locale, 'hero.sub')}>
  <section class="hero">
    <span class="tagline">{t(locale, 'tagline')}</span>
    <h1>{t(locale, 'hero.title')}</h1>
    <p class="sub">{t(locale, 'hero.sub')}</p>
    <div class="cta">
      <a class="primary" href={getRelativeLocaleUrl(locale, 'demo')}>{t(locale, 'cta.demo')}</a>
      <a class="secondary" href={getRelativeLocaleUrl(locale, 'docs')}>{t(locale, 'cta.docs')}</a>
    </div>
    <div class="stats">
      <div class="stat"><b>{statIndicators}</b><span>{t(locale, 'stat.indicators')}</span></div>
      <div class="stat"><b>{statSources}</b><span>{t(locale, 'stat.sources')}</span></div>
      {statTools != null && (
        <div class="stat"><b>{statTools}</b><span>{t(locale, 'stat.tools')}</span></div>
      )}
    </div>
  </section>
  <section class="lines-strip">
    <h2><a href={getRelativeLocaleUrl(locale, 'products')}>{t(locale, 'home.lines.title')}</a></h2>
    <p class="sub">{t(locale, 'home.lines.sub')}</p>
    <ul class="grid">
      {
        PRODUCT_LINES.map((l) => (
          <li class="card">
            <a class="card-main" href={getRelativeLocaleUrl(locale, `products/${l}`)}>
              <span class="name">{t(locale, `line.${l}`)}</span>
              <span class="desc">{t(locale, `line.${l}.desc`)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="research">
    <h2>{t(locale, 'home.research.title')}</h2>
    <p>{t(locale, 'home.research.papers')}</p>
    <p>{t(locale, 'home.research.finetune')}</p>
  </section>
  <section class="roadmap-strip">
    <h2><a href={getRelativeLocaleUrl(locale, 'roadmap')}>{t(locale, 'roadmap.strip.title')}</a></h2>
    <ol>
      {
        phases.map((p) => (
          <li class={p.data.status}>
            <b>
              {p.data.name} <em>{p.data.pinyin}</em>
            </b>
            <span class="period">{p.data.period_en}</span>
            <span class={`phase-status ${p.data.status}`}>{t(locale, `roadmap.status.${p.data.status}`)}</span>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
