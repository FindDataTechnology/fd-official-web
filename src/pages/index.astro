---
import Layout from '../components/Layout.astro';
import LineMark from '../components/LineMark.astro';
import { t } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';
import { PRODUCT_LINES, LADDER_CHARS } from '../content.config';
// Homepage figures come from the same build-time exports the /indicators and
// /repos pages serve (content-integrity: no hand-written numbers).
import indicatorData from '../data/indicators.json';
import reposJson from '../data/repos.json';

const locale = 'en';
const title = t(locale, 'hero.title') + ' — FindData Technology';
const phases = (await getCollection('roadmap')).sort((a, b) => a.data.order - b.data.order);
const raw = indicatorData as { active_concepts?: number | null; tools_count?: number | null };
const statConcepts = raw.active_concepts ?? null;
const statTools = raw.tools_count ?? null;
const statRepos = (reposJson as { repos: unknown[] }).repos.length;
const fmt = (n: number) => n.toLocaleString(locale);
const lineHref = (l: string) => getRelativeLocaleUrl(locale, `products/${l}`);
---

<Layout locale={locale} title={title} description={t(locale, 'hero.sub')}>
  <section class="hero">
    <h1>{t(locale, 'hero.title')}</h1>
    <p class="sub">{t(locale, 'hero.sub')}</p>
    <div class="cta">
      <a class="primary" href={getRelativeLocaleUrl(locale, 'products')}>{t(locale, 'cta.products')}</a>
      <a class="secondary" href={getRelativeLocaleUrl(locale, 'demo')}>{t(locale, 'cta.demo')}</a>
    </div>
    <p class="statline">
      {
        [
          statConcepts != null && `${fmt(statConcepts)} ${t(locale, 'stat.concepts')}`,
          statTools != null && `${fmt(statTools)} ${t(locale, 'stat.tools')}`,
          `${fmt(statRepos)} ${t(locale, 'stat.repos')}`,
        ]
          .filter(Boolean)
          .join(' · ')
      }
    </p>
  </section>
  <section class="lines-strip">
    <h2><a href={getRelativeLocaleUrl(locale, 'products')}>{t(locale, 'home.lines.title')}</a></h2>
    <p class="sub">{t(locale, 'home.lines.sub')}</p>
    <ul class="grid">
      {
        PRODUCT_LINES.map((l, i) => (
          <li class="card">
            <a class="card-main" href={lineHref(l)}>
              <LineMark char={LADDER_CHARS[i]} name={t(locale, `line.${l}`)} size="md" />
              <span class="name lines-name">{t(locale, `line.${l}`)}</span>
              <span class="desc">{t(locale, `line.${l}.desc`)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="research">
    <h2>{t(locale, 'home.research.title')}</h2>
    <p>{t(locale, 'home.research.finetune')}</p>
  </section>
  <section class="roadmap-strip">
    <h2><a href={getRelativeLocaleUrl(locale, 'roadmap')}>{t(locale, 'roadmap.strip.title')}</a></h2>
    <ol>
      {
        phases.map((p) => (
          <li class={p.data.status}>
            <b>
              {p.data.name} <em>{p.data.pinyin}</em>
            </b>
            <span class="period">{p.data.period_en}</span>
            <span class={`phase-status ${p.data.status}`}>{t(locale, `roadmap.status.${p.data.status}`)}</span>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
