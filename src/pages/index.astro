---
import Layout from '../components/Layout.astro';
import { t } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';

const locale = 'en';
const title = 'FindData Technology — Open data, wired for AI agents';
const phases = (await getCollection('roadmap')).sort((a, b) => a.data.order - b.data.order);
// Hand-written app entries (en/<slug>.md) — the products layer above open source.
const apps = (await getCollection('apps'))
  .filter((a) => a.id.startsWith('en/'))
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100))
  .slice(0, 3);
const slugOf = (a) => a.id.split('/')[1];
---

<Layout locale={locale} title={title} description={t(locale, 'hero.sub')}>
  <section class="hero">
    <span class="tagline">{t(locale, 'tagline')}</span>
    <h1>{t(locale, 'hero.title')}</h1>
    <p class="sub">{t(locale, 'hero.sub')}</p>
    <div class="cta">
      <a class="primary" href={getRelativeLocaleUrl(locale, 'demo')}>{t(locale, 'cta.demo')}</a>
      <a class="secondary" href={getRelativeLocaleUrl(locale, 'docs')}>{t(locale, 'cta.docs')}</a>
    </div>
    <div class="stats">
      <div class="stat"><b>6026</b><span>{t(locale, 'stat.indicators')}</span></div>
      <div class="stat"><b>28</b><span>{t(locale, 'stat.sources')}</span></div>
      <div class="stat"><b>56</b><span>{t(locale, 'stat.tools')}</span></div>
    </div>
  </section>
  <section class="about">
    <h2>{t(locale, 'about.title')}</h2>
    <p>{t(locale, 'about.body')}</p>
    <p><a href={getRelativeLocaleUrl(locale, 'fd-open-data-mcp')}>{t(locale, 'flagship.cta')}</a></p>
  </section>
  <section class="apps-strip">
    <h2><a href={getRelativeLocaleUrl(locale, 'apps')}>{t(locale, 'home.products.title')}</a></h2>
    <p class="sub">{t(locale, 'home.products.sub')}</p>
    <ul class="grid">
      {
        apps.map((a) => (
          <li class="card">
            <a class="card-main" href={`/apps/${slugOf(a)}`}>
              <span class="name">{a.data.name}</span>
              <span class="desc">{a.data.tagline}</span>
              <span class="meta">{a.data.kind}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p><a href={getRelativeLocaleUrl(locale, 'apps')}>{t(locale, 'home.products.all')}</a></p>
  </section>
  <section class="roadmap-strip">
    <h2><a href={getRelativeLocaleUrl(locale, 'roadmap')}>{t(locale, 'roadmap.strip.title')}</a></h2>
    <ol>
      {
        phases.map((p) => (
          <li class={p.data.status}>
            <b>
              {p.data.name} <em>{p.data.pinyin}</em>
            </b>
            <span class="period">{p.data.period_en}</span>
            <span class={`phase-status ${p.data.status}`}>{t(locale, `roadmap.status.${p.data.status}`)}</span>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
