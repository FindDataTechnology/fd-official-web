# Domestic build path (since 2026-09-21; the GitHub-hosted image build is
# disabled by policy — see .github/workflows/build-image.yml).
#
# Full site build INSIDE Docker so the build host needs only docker:
# stage 1 runs the build-time data fetches + `astro build`, stage 2 packages
# dist/ into nginx. Tokens passed as build args live only in the discarded
# build stage — the pushed nginx stage contains no tokens and no source.
#
#   docker build -f Dockerfile.build \
#     --build-arg GITHUB_TOKEN=... \
#     --build-arg FD_INDICATORS_MCP_TOKEN=... \
#     -t harbor.finddatatech.cloud:8080/fd-web/official-web:<sha>-<ts> .
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Optional tokens; the fetches keep last-good snapshots when unset.
ARG GITHUB_TOKEN=""
ARG FD_INDICATORS_MCP_TOKEN=""
ARG FD_INDICATORS_MCP_URL=https://www.finddatatech.cloud/mcp
RUN GITHUB_TOKEN="$GITHUB_TOKEN" \
    FD_INDICATORS_MCP_TOKEN="$FD_INDICATORS_MCP_TOKEN" \
    FD_INDICATORS_MCP_URL="$FD_INDICATORS_MCP_URL" \
    npm run build

FROM nginx:1.29-alpine
COPY deploy/docker/nginx-site.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/
EXPOSE 80
