# LibreChat reverse proxy — chat.finddatatech.cloud
# :80 stage. certbot --nginx adds the :443 ssl block + HTTP->HTTPS 301 and
# copies this `location /` into it. Proxies to k3s NodePort 127.0.0.1:30830 with
# WebSocket / SSE streaming support.
#
# The sub_filter block below MUST also be present in the certbot-managed :443
# server block on the live host (certbot already ran, so it won't re-copy).
# If you re-cert/redeploy, re-apply the sub_filter lines to the :443 block too.

server {
    listen 80;
    listen [::]:80;
    server_name chat.finddatatech.cloud;

    location / {
        proxy_pass http://127.0.0.1:30830;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket / SSE streaming (design Decision 4) — without these the
        # LibreChat UI hangs or truncates responses.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Long timeouts so streamed responses are not cut at the 60s default.
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        proxy_buffering off;

        # Default UI language to Simplified Chinese for first-time visitors.
        # LibreChat's i18n reads localStorage('lang') on boot (detectInitialLanguage).
        # Inject a script that sets it only when empty — so a user's explicit
        # language choice in Settings persists across reloads (cookie would
        # override it, since LibreChat reads cookie before localStorage but never
        # writes one). sub_filter needs uncompressed upstream → blank Accept-Encoding.
        proxy_set_header Accept-Encoding "";
        sub_filter '</head>' '<script>if(!localStorage.getItem("lang"))localStorage.setItem("lang","zh-Hans")</script></head>';
        sub_filter_once on;
        sub_filter_types text/html;
    }
}
