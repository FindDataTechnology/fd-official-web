# LibreChat reverse proxy — chat.finddatatech.cloud
# :80 stage. certbot --nginx will add the :443 ssl block + HTTP->HTTPS 301.
# Proxies to the k3s NodePort 127.0.0.1:30830 with WebSocket / SSE streaming support.

server {
    listen 80;
    listen [::]:80;
    server_name chat.finddatatech.cloud;

    location / {
        proxy_pass http://127.0.0.1:30830;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket / SSE streaming (design Decision 4) — without these the
        # LibreChat UI hangs or truncates responses.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Long timeouts so streamed responses are not cut at the 60s default.
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        proxy_buffering off;
    }
}
